#!/usr/bin/env bash
# Emits compact JSON for the "Claude Quota" KDE plasmoid.
#
# Two data sources, selected by CLAUDE_QUOTA_MODE (local|online|auto):
#   local  - ccusage over ~/.claude transcripts. Offline; a token *proxy*
#            (% is vs a denominator, not your real quota).
#   online - your REAL session/weekly utilization from api.anthropic.com, via
#            Claude Code's login token (auto-read from ~/.claude/.credentials.json,
#            which carries the user:profile scope). A pasted Bearer token, passed
#            as CLAUDE_QUOTA_TOKEN_B64, overrides the auto-read one.
#   auto   - try online, fall back to local on any failure.
#
# Local denominators (0/unset => p90 of history, ignoring outliers):
#   CLAUDE_QUOTA_TOKEN_LIMIT, CLAUDE_QUOTA_WEEKLY_LIMIT
# Cache: CLAUDE_QUOTA_CACHE_TTL seconds (default 30).
# Stale online data is reused for CLAUDE_QUOTA_ONLINE_MAX_AGE seconds (default
# 3600) when the API refuses; set 0 to disable and fall through instead.
# Testing: CLAUDE_QUOTA_USAGE_FILE replays a recorded API body (no network).
set -uo pipefail

# ---------------------------------------------------------------------------
# PATH hardening. plasmashell hands this script the *session* PATH, not your
# interactive shell rc, so runtimes installed per-user (nvm, fnm, bun, volta,
# asdf, mise, n) are invisible and every `node`/`ccusage`/`npx` lookup fails
# with a bare {"error":"ccusage failed"}. Append the standard locations; only
# directories that actually exist are added, and PATH order is preserved.
# ---------------------------------------------------------------------------
_add_path() {
  [ -n "${1:-}" ] && [ -d "$1" ] || return 0
  case ":$PATH:" in *":$1:"*) ;; *) PATH="$PATH:$1" ;; esac
  return 0
}

_add_path "$HOME/.local/bin"
_add_path "/usr/local/bin"
_add_path "$HOME/.bun/bin"                  # bun
_add_path "$HOME/.volta/bin"                # volta
_add_path "$HOME/.asdf/shims"               # asdf
_add_path "$HOME/.local/share/mise/shims"   # mise
_add_path "$HOME/n/bin"                     # n
_add_path "$HOME/.nodenv/shims"             # nodenv

# nvm and fnm keep one directory per Node version. Prefer nvm's `default`
# alias (what your shell would pick), then fall back to the newest installed.
_nvm_dir="${NVM_DIR:-$HOME/.nvm}"
if [ -f "$_nvm_dir/alias/default" ]; then
  _want=$(cat "$_nvm_dir/alias/default" 2>/dev/null || true)
  [ -n "${_want:-}" ] && _add_path "$_nvm_dir/versions/node/v${_want#v}/bin"
fi
for _root in "$_nvm_dir/versions/node" "$HOME/.local/share/fnm/node-versions" "$HOME/.fnm/node-versions"; do
  [ -d "$_root" ] || continue
  _latest=$(ls -1 "$_root" 2>/dev/null | sort -V | tail -1)
  [ -n "${_latest:-}" ] || continue
  _add_path "$_root/$_latest/bin"
  _add_path "$_root/$_latest/installation/bin"   # fnm layout
done
export PATH

MODE="${CLAUDE_QUOTA_MODE:-local}"
# Reason shown when the online path gives up. Narrowed from the API's own
# error type where it says one, so a rate limit is not reported as a bad token.
ONLINE_ERR="online fetch failed (token invalid/expired or endpoint changed)"
WIN_LIMIT="${CLAUDE_QUOTA_TOKEN_LIMIT:-auto}"
WEEK_LIMIT="${CLAUDE_QUOTA_WEEKLY_LIMIT:-auto}"
TTL="${CLAUDE_QUOTA_CACHE_TTL:-30}"
CRED_FILE="${CLAUDE_QUOTA_CRED_FILE:-$HOME/.claude/.credentials.json}"
# Last successful API body, replayed when the endpoint refuses (it rate-limits
# well below a per-minute poll). Serving the stale body beats dropping to the
# local proxy: the layout stays put and only the freshness badge changes.
ONLINE_CACHE="${TMPDIR:-/tmp}/claude-quota-online-${UID:-$(id -u)}.json"
ONLINE_MAX_AGE="${CLAUDE_QUOTA_ONLINE_MAX_AGE:-3600}"

# Scratch file for the current write. plasmashell can tear this script down
# between ticks, so clean it up on any exit rather than leaving empties in /tmp.
_scratch=""
trap 'rm -f "${_scratch:-}"' EXIT HUP INT TERM

# ---------------------------------------------------------------------------
# ONLINE: query api.anthropic.com/api/oauth/usage for the real utilization.
# Prints JSON and returns 0 on success; non-zero on any failure.
# ---------------------------------------------------------------------------
_oauth_usage() { # $1 = bearer token -> echoes response body
  curl -s --max-time 8 \
    -H "Authorization: Bearer $1" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "anthropic-version: 2023-06-01" \
    -H "Accept: application/json" \
    "https://api.anthropic.com/api/oauth/usage" 2>/dev/null
}

# Renders an API body ($1) into the widget's JSON. $2 = age in seconds (0 =
# just fetched). Returns non-zero if the body is not a usable usage payload.
_render_usage() {
  printf '%s' "$1" | node -e '
    let s = ""; process.stdin.on("data", d => s += d).on("end", () => {
      let j; try { j = JSON.parse(s); } catch (e) { process.exit(1); }
      // Cloudflare HTML / login page / anything unrecognised => bail.
      if (!j || (!Array.isArray(j.limits) && !j.five_hour)) process.exit(1);

      const now = Date.now(), DAY = 86400000;
      // Seconds since this body was fetched. Everything time-derived below is
      // recomputed against `now`, so a replayed body still shows correct reset
      // times -- only the utilization figures themselves are as old as this.
      const ageSeconds = Math.max(0, parseInt(process.argv[1], 10) || 0);
      let tz = "";
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) {}

      const hhmm = d => String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0");
      // A session resets within the day, so a bare time reads better there;
      // weekly limits need the date to be unambiguous.
      const fmt = (iso, withDate) => {
        if (!iso) return null;
        const d = new Date(iso);
        if (isNaN(d.getTime())) return null;
        // en-US month name on purpose: the widget UI is English throughout, and
        // the system locale would otherwise mix languages inside one line.
        return withDate
          ? d.toLocaleDateString("en-US", { month: "short", day: "numeric" }) + ", " + hhmm(d)
          : hhmm(d);
      };
      const remMin  = iso => iso ? Math.max(0, Math.round((new Date(iso) - now) / 60000)) : null;
      const remDays = iso => iso ? Math.max(0, Math.ceil((new Date(iso) - now) / DAY)) : null;

      // `limits` is what /usage itself renders. Mirror its wording, and label
      // any kind the API adds later from its own kind + scope rather than
      // dropping it -- new limits then show up without a widget release.
      const titleCase = k => k.replace(/_/g, " ").replace(/\b\w/g, c => c.toUpperCase());
      const labelFor = l => {
        const sc = l.scope || {};
        const name = (sc.model && sc.model.display_name) || sc.surface || null;
        if (l.kind === "session") return "Current session";
        if (l.kind === "weekly_all") return "Current week (all models)";
        if (l.group === "weekly" || /^(weekly|seven_day)/.test(l.kind || ""))
          return name ? "Current week (" + name + ")" : "Current week";
        const base = titleCase(l.kind || "limit");
        return name ? base + " (" + name + ")" : base;
      };

      const limits = (Array.isArray(j.limits) ? j.limits : [])
        .filter(l => l && typeof l.percent === "number")
        .map(l => ({
          kind: l.kind || "",
          label: labelFor(l),
          pct: Math.round(l.percent),
          severity: l.severity || "normal",
          resetHuman: fmt(l.resets_at, l.kind !== "session"),
          remainingMinutes: remMin(l.resets_at),
          remainingDays: remDays(l.resets_at)
        }));

      // The compact panel view needs a session and a weekly figure. Prefer
      // limits[]; fall back to the older top-level objects if it is absent.
      const byKind = k => limits.find(l => l.kind === k);
      const legacyPct = o => o && typeof o.utilization === "number" ? Math.round(o.utilization) : 0;
      const ses = byKind("session"), wal = byKind("weekly_all");
      const fh = j.five_hour || null, sd = j.seven_day || null;

      const windowOut = ses
        ? { active: true, pct: ses.pct, resetHuman: ses.resetHuman, remainingMinutes: ses.remainingMinutes }
        : (fh ? { active: true, pct: legacyPct(fh), resetHuman: fmt(fh.resets_at, false), remainingMinutes: remMin(fh.resets_at) }
              : { active: false });
      const weekOut = wal
        ? { active: true, pct: wal.pct, resetHuman: wal.resetHuman, remainingDays: wal.remainingDays }
        : (sd ? { active: true, pct: legacyPct(sd), resetHuman: fmt(sd.resets_at, true), remainingDays: remDays(sd.resets_at) }
              : { active: false });

      // Only worth a line once there is something to report.
      const eu = j.extra_usage || {};
      const euLimit = eu.monthly_limit || 0, euUsed = eu.used_credits || 0;
      const extra = (eu.is_enabled && (euLimit > 0 || euUsed > 0))
        ? { enabled: true, used: euUsed, limit: euLimit, currency: eu.currency || "" }
        : { enabled: false };

      console.log(JSON.stringify({
        source: "online", tz, limits, ageSeconds,
        window: windowOut, week: weekOut, extra
      }));
    });
  ' "$2"
}

fetch_online() {
  local resp="" token=""
  if [ -n "${CLAUDE_QUOTA_USAGE_FILE:-}" ]; then
    # Test/debug hook: replay a recorded /api/oauth/usage body instead of
    # calling out. Unset in normal use, so this changes nothing for users.
    resp=$(cat "$CLAUDE_QUOTA_USAGE_FILE" 2>/dev/null)
  elif [ -n "${CLAUDE_QUOTA_TOKEN_B64:-}" ]; then
    # Explicit override: a pasted Bearer token (note: `claude setup-token`
    # tokens lack the user:profile scope and will 403 here).
    token=$(printf '%s' "$CLAUDE_QUOTA_TOKEN_B64" | base64 -d 2>/dev/null)
    resp=$(_oauth_usage "$token")
  elif [ -f "$CRED_FILE" ] && command -v jq >/dev/null 2>&1; then
    # Default: reuse Claude Code's own login token (has user:profile, auto-
    # refreshed while you use Claude Code). Clean api host, no cookies.
    token=$(jq -r '.claudeAiOauth.accessToken // empty' "$CRED_FILE" 2>/dev/null)
    [ -n "$token" ] && resp=$(_oauth_usage "$token")
  else
    return 1
  fi
  [ -n "$resp" ] || return 1
  # Narrow the failure reason from the API's own error type, but only when the
  # body actually is an error envelope -- never on a successful payload.
  case "$resp" in
    *'"error"'*)
      case "$resp" in
        *rate_limit_error*)
          ONLINE_ERR="rate limited by api.anthropic.com - retrying at next refresh"; return 1 ;;
        *authentication_error*|*permission_error*|*invalid_request_error*)
          ONLINE_ERR="token rejected - open Claude Code to refresh your login"; return 1 ;;
      esac ;;
  esac
  _render_usage "$resp" 0 || return 1
  # Cache only a body that actually rendered.
  _scratch=$(mktemp "$(dirname "$ONLINE_CACHE")/claude-quota-online-XXXXXX" 2>/dev/null) \
    && printf '%s' "$resp" > "$_scratch" && mv -f "$_scratch" "$ONLINE_CACHE" \
    || rm -f "${_scratch:-}"
  _scratch=""
  return 0
}

# Replay the last good API body when the endpoint is unavailable, as long as it
# is still within ONLINE_MAX_AGE.
fetch_online_stale() {
  [ "${ONLINE_MAX_AGE:-0}" -gt 0 ] 2>/dev/null || return 1
  [ -s "$ONLINE_CACHE" ] || return 1
  local age
  age=$(( $(date +%s) - $(stat -c %Y "$ONLINE_CACHE" 2>/dev/null || echo 0) ))
  [ "$age" -ge 0 ] && [ "$age" -le "$ONLINE_MAX_AGE" ] || return 1
  _render_usage "$(cat "$ONLINE_CACHE")" "$age"
}


# ---------------------------------------------------------------------------
# LOCAL: ccusage proxy (cached raw scan + p90 denominator + projection/ETA).
# ---------------------------------------------------------------------------
emit_local() {
  if command -v ccusage >/dev/null 2>&1; then RUN=(ccusage); else RUN=(npx -y ccusage@latest); fi
  local CACHE_DIR="${TMPDIR:-/tmp}"
  local BLK="$CACHE_DIR/claude-quota-blocks-${UID:-$(id -u)}.json"
  local WK="$CACHE_DIR/claude-quota-weekly-${UID:-$(id -u)}.json"
  fresh() { [ -f "$1" ] && [ $(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) )) -lt "$TTL" ]; }

  # The raw scans are handed to node as *file paths*, never as argv strings: a
  # busy ~/.claude pushes `blocks --json` past MAX_ARG_STRLEN (128 KiB) and the
  # exec dies with E2BIG. Each cache file is refreshed atomically via mktemp, so
  # a failed or empty scan leaves the previous good copy in place.
  local spec
  if ! fresh "$BLK" || ! fresh "$WK"; then
    for spec in "blocks:$BLK" "weekly:$WK"; do
      _scratch=$(mktemp "$CACHE_DIR/claude-quota-XXXXXX") || continue
      if "${RUN[@]}" "${spec%%:*}" --offline --json > "$_scratch" 2>/dev/null && [ -s "$_scratch" ]; then
        mv -f "$_scratch" "${spec#*:}"
      else
        rm -f "$_scratch"
      fi
      _scratch=""
    done
  fi
  if [ ! -s "$BLK" ] && [ ! -s "$WK" ]; then echo '{"error":"ccusage failed"}'; return 0; fi

  node -e '
    const fs = require("fs");
    const winLimitArg = process.argv[3], weekLimitArg = process.argv[4];
    const readJson = p => { try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch (e) { return null; } };
    const DAY = 86400000;
    function p90(values) {
      const s = values.filter(v => v > 0).sort((a, b) => a - b);
      if (!s.length) return 1;
      return Math.max(1, s[Math.min(s.length - 1, Math.floor(0.9 * s.length))]);
    }
    const resolveLimit = (arg, all) => (arg === "auto" || arg === "max") ? p90(all) : (parseInt(arg, 10) || 1);

    let windowOut = { active: false };
    const bj = readJson(process.argv[1]);
    if (bj) {
      const blocks = (bj.blocks || []).filter(b => !b.isGap);
      const active = blocks.find(b => b.isActive);
      if (active) {
        const tokens = active.totalTokens || 0;
        const limit = resolveLimit(winLimitArg, blocks.map(b => b.totalTokens || 0));
        const burn = active.burnRate ? Math.round(active.burnRate.tokensPerMinute) : 0;
        const proj = active.projection ? active.projection.totalTokens : tokens;
        const r = new Date(active.endTime);
        const eta = (burn > 0 && tokens < limit) ? Math.round((limit - tokens) / burn) : null;
        windowOut = {
          active: true, tokens, limit,
          pct: Math.min(100, Math.round(tokens / limit * 100)),
          cost: Math.round((active.costUSD || 0) * 100) / 100,
          burn, projection: proj, projectionPct: Math.round(proj / limit * 100), etaMinutes: eta,
          resetHuman: String(r.getHours()).padStart(2, "0") + ":" + String(r.getMinutes()).padStart(2, "0"),
          remainingMinutes: Math.max(0, Math.round((r - Date.now()) / 60000))
        };
      }
    }
    let weekOut = { active: false };
    const wj = readJson(process.argv[2]);
    if (wj) {
      const weeks = wj.weekly || wj.weeks || wj.data || [];
      const now = Date.now();
      // ccusage 18.x names the week-start field `week`; older builds used
      // `period`. Reading only `period` made every date invalid, which silently
      // fell through to the trailing entry and reported a NaN reset.
      const weekStart = w => {
        const key = w.week || w.period;
        if (!key) return NaN;
        const t = new Date(key + "T00:00:00").getTime();
        return isNaN(t) ? NaN : t;
      };
      let cur = null;
      for (const w of weeks) {
        const s = weekStart(w);
        if (isNaN(s)) continue;
        if (s <= now && now < s + 7 * DAY) { cur = { w, end: s + 7 * DAY }; break; }
      }
      if (!cur && weeks.length) {
        const w = weeks[weeks.length - 1], s = weekStart(w);
        cur = { w, end: isNaN(s) ? null : s + 7 * DAY };
      }
      if (cur) {
        const tokens = cur.w.totalTokens || 0;
        const limit = resolveLimit(weekLimitArg, weeks.map(x => x.totalTokens || 0));
        weekOut = {
          active: true, tokens, limit,
          pct: Math.min(100, Math.round(tokens / limit * 100)),
          cost: Math.round((cur.w.totalCost || 0) * 100) / 100,
          // null (not 0) when the week start is unreadable, so the widget can
          // omit the line rather than claim it resets today.
          remainingDays: cur.end === null ? null : Math.max(0, Math.ceil((cur.end - now) / DAY))
        };
      }
    }
    console.log(JSON.stringify({ source: "local", window: windowOut, week: weekOut }));
  ' "$BLK" "$WK" "$WIN_LIMIT" "$WEEK_LIMIT"
}

# ---------------------------------------------------------------------------
case "$MODE" in
  online) fetch_online || fetch_online_stale || printf '{"error":"%s"}\n' "$ONLINE_ERR" ;;
  auto)   fetch_online || fetch_online_stale || emit_local ;;
  *)      emit_local ;;
esac
